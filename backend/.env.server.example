# Скопируйте этот файл в .env на сервере:
# cp .env.server.example .env
# И измените пароли и секретный ключ!

# Окружение
NODE_ENV=production
PORT=3000

# JWT Секрет (обязательно сгенерируйте свой! Например: openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS (разрешенные источники: домен, локалхост, мобильные клиенты)
ALLOWED_ORIGINS=https://primakov.ddns.net,http://primakov.ddns.net,http://localhost:3000,*

# PostgreSQL (в Docker Compose сервисы видят друг друга по имени сервиса: postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=primakovapp
DB_USER=primakov
DB_PASSWORD=primakov_secure_password_change_me
POSTGRES_PASSWORD=primakov_secure_password_change_me
